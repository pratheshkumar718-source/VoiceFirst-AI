# VoiceFirst AI - Environment Variables

# Google Gemini API
# Get your API key from Google AI Studio: https://aistudio.google.com
GEMINI_API_KEY=

# Gemini Models
GEMINI_LIVE_MODEL=models/gemini-2.0-flash-exp
GEMINI_VISION_MODEL=gemini-2.0-flash
GEMINI_EXTRACTION_MODEL=gemini-2.0-flash

# Supabase (Optional for MVP; automatically falls back to local storage if empty)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DOCUMENTS_BUCKET=documents
SUPABASE_PDFS_BUCKET=generated-pdfs

